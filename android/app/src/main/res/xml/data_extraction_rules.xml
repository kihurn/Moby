<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- SharedPreferences can leave a recovery copy after an interrupted write. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="pairing.xml" />
        <exclude domain="sharedpref" path="pairing.xml.bak" />
        <exclude domain="sharedpref" path="usb.xml" />
        <exclude domain="sharedpref" path="usb.xml.bak" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="pairing.xml" />
        <exclude domain="sharedpref" path="pairing.xml.bak" />
        <exclude domain="sharedpref" path="usb.xml" />
        <exclude domain="sharedpref" path="usb.xml.bak" />
    </device-transfer>
</data-extraction-rules>
